# WebSocket endpoint of the OpenIdle backend. In `bun run dev` this is also the
# default when unset; in a built frontend it is required, and the client refuses
# to start without it rather than quietly dialling localhost.
#
# Point this at the dev backend to run the frontend locally against it:
#   PUBLIC_WS_URL=wss://api.dev.openidle.example/ws
PUBLIC_WS_URL=ws://localhost:5066/ws

# Lets a visitor redirect this frontend at another backend with ?ws=<url>,
# remembered until ?ws= clears it. Set on the deployed dev frontend so any
# developer can aim it at the backend running on their own machine; left unset
# in production, where the frontend must only ever reach its own backend.
# `bun run dev` enables it regardless.
# PUBLIC_ALLOW_WS_OVERRIDE=true
