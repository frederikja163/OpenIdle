# Non-secret defaults, tracked. `bun run dev`, `build` and `preview` read this
# file; a deployed server does not — it takes PUBLIC_* from the process
# environment. Per-machine values go in .env.local (gitignored, see
# .env.example), which overrides this file.

# WebSocket endpoint of the OpenIdle backend, as Backend binds it in development.
PUBLIC_WS_URL=ws://localhost:5066/ws

# Shows the protocol console (/debug) link in the top bar. Only `true` turns it on.
PUBLIC_DEBUG=true