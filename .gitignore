# .NET build results
[Bb]in/
[Oo]bj/

# Visual Studio / Rider
.vs/
.idea/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Local configuration / secrets
appsettings.Development.json

# Junction to .opencode/skills so Claude Code discovers the same skills.
# The real files live in .opencode/skills and are tracked there; ignoring this
# avoids committing them twice. Other .claude/ files (settings.json) stay tracked.
/.claude/skills/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# SQLite databases
*.db
*.db-shm
*.db-wal
*.db-journal

# Generated DTO preview output (dotnet run --project Generators/Generator -t Cs).
# TypeScript DTOs are the exception: `bun run dev` regenerates them, and they are
# also committed so protocol changes show up in review and CI can flag drift.
**/*.generated.*