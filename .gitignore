# .NET build results
[Bb]in/
[Oo]bj/

# Visual Studio / Rider
.vs/
.idea/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Local configuration / secrets
appsettings.Development.json

# Junction to .opencode/skills so Claude Code discovers the same skills.
# The real files live in .opencode/skills and are tracked there; ignoring this
# avoids committing them twice. Other .claude/ files (settings.json) stay tracked.
/.claude/skills/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# SQLite databases
*.db
*.db-shm
*.db-wal
*.db-journal

# Generated DTO preview output (dotnet run --project Generators/Generator -t Cs)
# and the TypeScript emitters' output. Never checked in: `bun run generate` runs
# on dev/build/check locally, and Frontend/Dockerfile regenerates in the image
# from its own commit's types.xml, so a stale copy can never ship.
**/*.generated.*

# Per-host deployment values. deploy/.env.example is the tracked template.
deploy/.env
deploy/.env.*
!deploy/.env.example
