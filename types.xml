<?xml version="1.0" encoding="utf-8"?>
<Types>
  <Skill name="Mining">
    <Slot name="Head" required="true">
      <Tag name="head"/>
    </Slot>
    <Slot name="Handle" required="true">
      <Tag name="handle"/>
    </Slot>
  </Skill>
  <Skill name="LumberJacking"/>
  <Skill name="Crafting"/>

  <Item name="Stone">
    <Tag name="ore"/>
  </Item>
  <Item name="BrokenRock">
    <Tag name="ore"/>
  </Item>
  <Item name="Wood">
    <Tag name="wood"/>
  </Item>
  <Item name="Food">
    <Tag name="food"/>
  </Item>

  <Item name="IronPickaxeHead">
    <Tag name="head"/>
    <Tag name="iron"/>
    <Stat name="speed" value="1.1"/>
    <Stat name="itemProductivity" value="1.25"/>
    <Stat name="xpProductivity" value="1.0"/>
    <Stat name="durable" value="1.5"/>
  </Item>

  <Item name="OakHandle">
    <Tag name="handle"/>
    <Stat name="speed" value="0.9"/>
    <Stat name="durable" value="1.2"/>
  </Item>

  <DropTable name="BrokenRockTable">
    <ItemReward item="None" weight="10" count="0"/>
    <ItemReward item="BrokenRock" weight="1" count="1"/>
  </DropTable>

  <DropTable name="StoneTable">
    <ItemReward item="Stone" weight="5" count="2"/>
    <TableReward table="BrokenRockTable" weight="1" count="1"/>
  </DropTable>

  <Activity name="Stone" time="2.5">
    <ItemReward item="Stone" count="4"/>
    <XpReward skill="Mining" count="10"/>
    <TableReward table="StoneTable" count="1"/>
    <LevelRequirement skill="Mining" count="1"/>
  </Activity>

  <Dto name="Item">
    <Property name="ProfileId" type="Guid"/>
    <Property name="ItemId" type="ItemId"/>
    <Property name="Count" type="Int"/>
  </Dto>

  <Dto name="Profile">
    <Property name="Name" type="String" />
    <Property name="ProfileId" type="Guid" />
  </Dto>

  <Dto name="Skill">
    <Property name="ProfileId" type="Guid"/>
    <Property name="SkillId" type="SkillId"/>
    <Property name="Xp" type="Int"/>
    <Property name="Level" type="Int"/>
  </Dto>

  <Dto name="User">
    <Property name="UserId" type="Guid" />
  </Dto>

  <Request name="CreateProfile">
    <Property name="Name" type="String" />
    <Response />
  </Request>

  <Event name="ProfilesChanged">
    <Property name="Profiles" type="Profile" multiple="true" />
  </Event>

  <Event name="ActivityEnded">
    <Property name="ActivityId" type="ActivityId"/>
    <Property name="Items" type="Item" multiple="true" />
    <Property name="Skills" type="Skill" multiple="true" />
  </Event>

  <Request name="ListProfiles">
    <Response>
      <Property name="Profiles" type="Profile" multiple="true" />
    </Response>
  </Request>

  <Request name="LoginAsTestUser">
    <Response />
  </Request>

  <Request name="SelectProfile">
    <Property name="ProfileId" type="Guid" />
    <Response />
  </Request>

  <Request name="StartActivity">
    <Property name="ActivityId" type="ActivityId"/>
    <Response />
  </Request>

  <Request name="GetSkills">
    <Property name="SkillIds" type="SkillId" multiple="true" optional="true"/>
    <Response>
      <Property name="Skills" type="Skill" multiple="true" />
    </Response>
  </Request>

  <Request name="GetItems">
    <Property name="ItemIds" type="ItemId" multiple="true" optional="true"/>
    <Response>
      <Property name="Items" type="Item" multiple="true" />
    </Response>
  </Request>

  <Response name="Error">
    <Property name="Message" type="String" />
  </Response>
</Types>
