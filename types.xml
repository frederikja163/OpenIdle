<?xml version="1.0" encoding="utf-8"?>
<Types>
  <Enum name="ItemId">
    <Value name="None"/>
    <Value name="Stone"/>
    <Value name="BrokenRock"/>
    <Value name="Wood"/>
    <Value name="Food"/>
  </Enum>
  
  <Enum name="SkillId">
    <Value name="None"/>
    <Value name="Mining"/>
    <Value name="LumberJacking"/>
    <Value name="Crafting"/>
  </Enum>
  
  <DropTable name="BrokenRockTable">
    <Drop item="None" weight="10" count="0"/>
    <Drop item="BrokenRock" weight="1" count="1"/>
  </DropTable>
  
  <DropTable name="StoneTable">
    <Drop item="Stone" weight="5" count="2"/>
    <Drop table="BrokenRockTable" weight="1" count="1"/>
  </DropTable>
  
  <Activity name="Stone" table="StoneTable"/>
  
  <Dto name="Item">
    <Property name="ProfileId" type="Guid"/>
    <Property name="ItemId" type="ItemId"/>
    <Property name="Count" type="Int"/>
  </Dto>
  
  <Dto name="Profile">
    <Property name="Name" type="String" />
    <Property name="ProfileId" type="Guid" />
  </Dto>
  
  <Dto name="Skill">
    <Property name="ProfileId" type="Guid"/>
    <Property name="SkillId" type="SkillId"/>
    <Property name="Xp" type="Int"/>
    <Property name="Level" type="Int"/>
  </Dto>

  <Dto name="User">
    <Property name="UserId" type="Guid" />
  </Dto>

  <Request name="CreateProfile">
    <Property name="Name" type="String" />
    <Response />
  </Request>

  <Event name="ProfilesChanged">
    <Property name="Profiles" type="Profile" multiple="true" />
  </Event>

  <Request name="ListProfiles">
    <Response>
      <Property name="Profiles" type="Profile" multiple="true" />
    </Response>
  </Request>

  <Request name="LoginAsTestUser">
    <Response />
  </Request>

  <Request name="SelectProfile">
    <Property name="ProfileId" type="Guid" />
    <Response />
  </Request>

  <Response name="Error">
    <Property name="Message" type="String" />
  </Response>
</Types>
