# Every variable docker-compose.yml needs. Set them in the Portainer stack
# (Environment variables -> Load variables from .env file), or copy this file to
# `.env` next to docker-compose.yml for a plain `docker compose up -d`; `.env` is
# gitignored. Never commit real values here: this file is tracked.
#
# The compose file refuses to start while any of these is unset or empty.

# --- hostnames ---------------------------------------------------------------
# Bare hostnames, no scheme or path: TLS is the reverse proxy's job, so the
# compose file builds https:// and wss:// URLs from them.

# Dev frontend. Its ORIGIN, and the one browser origin (besides a local
# `bun run dev` on localhost:5173) the dev backend accepts a socket from.
OPENIDLE_DEV_FRONTEND_HOST=openidle-dev.engbjerg.com
# Dev backend. The dev frontend dials wss://<this>/ws and fetches
# https://<this>/version, so the proxy must forward both.
OPENIDLE_DEV_BACKEND_HOST=openidle-backend-dev.engbjerg.com

# Prod frontend. Its ORIGIN, and the only browser origin the prod backend
# accepts a socket from.
OPENIDLE_PROD_FRONTEND_HOST=openidle.engbjerg.com
# Prod backend, as for dev.
OPENIDLE_PROD_BACKEND_HOST=openidle-backend.engbjerg.com

# Zitadel's public domain. Zitadel bakes it into its issuer and login URLs, so
# changing it after the first start means reconfiguring the instance.
OPENIDLE_ZITADEL_HOST=auth-openidle.engbjerg.com

# --- Zitadel secrets ---------------------------------------------------------

# Encrypts Zitadel's stored keys. Exactly 32 characters: `openssl rand -hex 16`.
# It must never change once Zitadel has started; back it up.
OPENIDLE_ZITADEL_MASTERKEY=

# Password of the `zitadel` role on the shared postgres container. It goes into
# a connection URL, so keep it URL-safe: `openssl rand -hex 24`. Use the same
# value in the `CREATE ROLE zitadel ... PASSWORD` run before the first start.
OPENIDLE_ZITADEL_DB_PASSWORD=

# Password of the `admin` user Zitadel creates in the OpenIdle org. Upper case,
# lower case, a digit and a symbol, 8+ characters. Only read on the very first
# start against an empty database; changing it later does nothing.
OPENIDLE_ZITADEL_ADMIN_PASSWORD=
