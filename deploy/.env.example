# Copy to `.env` next to the compose file on each host. Docker Compose reads it
# automatically; it is never committed and never baked into an image.

# GitHub account or organisation that owns the GHCR packages, lowercase.
GHCR_OWNER=frederikja163

# --- dev host ----------------------------------------------------------------
# Public origin the dev frontend is served on. Used twice: as the backend's
# WebSocket origin allowlist entry, and as adapter-node's ORIGIN.
DEV_FRONTEND_ORIGIN=https://dev.openidle.example
# WebSocket endpoint the dev frontend dials by default. wss:// when the backend
# is behind TLS, which it should be.
DEV_WS_URL=wss://api.dev.openidle.example/ws

# --- prod host ---------------------------------------------------------------
PROD_FRONTEND_ORIGIN=https://openidle.example
PROD_WS_URL=wss://api.openidle.example/ws

# --- ports -------------------------------------------------------------------
# What the reverse proxy in front of these containers forwards to. Only needed
# if the defaults collide with something already on the host.
#BACKEND_PORT=8080
#FRONTEND_PORT=3000
